generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled for app/runtime
  directUrl = env("DIRECT_URL") // direct for migrations/studio
}

enum Role {
  USER
  ADMIN
}

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String?        @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  role             Role           @default(USER)
  accounts         Account[]
  sessions         Session[]
  subscriptions    Subscription[]
  createdWorkshops Workshop[]     @relation("CreatedBy")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?
  priceId              String?
  currentPeriodEnd     DateTime?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Workshop {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  link        String?
  priceCents  Int      @default(0)
  capacity    Int?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("CreatedBy", fields: [createdById], references: [id])
}

model Contact {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  phone      String?
  message    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("contacts")
}

model Subscriber {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("subscribers")
}

model WorkshopEnquiry {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workshop_id       String?
  name              String
  email             String
  phone             String?
  city              String?
  // Legacy columns — kept so existing rows survive
  street            String?
  postcode          String?
  age_height_weight String?
  about             String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  // New application fields
  // @deprecated — removed from the application form; column kept so existing rows survive
  sex               String?
  age               Int?
  height_cm         Int?
  weight_kg         Int?
  health_notes      String?
  motivation        String?
  experience        String?
  consent_health    Boolean   @default(false)
  consent_privacy   Boolean   @default(false)
  consent_terms     Boolean   @default(false)
  consent_at        DateTime? @db.Timestamptz(6)
  status            String    @default("pending")
  admin_notes       String?
  updated_at        DateTime? @db.Timestamptz(6)
  // Partner fields — populated when two people book together
  partner_name         String?
  partner_age          Int?
  partner_height_cm    Int?
  partner_weight_kg    Int?
  partner_health_notes String?

  // Payment tracking — set by admin after acceptance
  room_type              String?   // "single" | "shared"
  people_count           Int?      // 1 or 2; auto-suggested from partner_name, overridable
  agreed_price_pp        Int?      // pence per person, locked at setup time
  early_bird_override    Boolean?  // null = auto (based on registration date), true/false = manual
  payment_status         String?   // null | "refunded" | "cancelled" — derived statuses computed from payments
  accepted_at            DateTime? @db.Timestamptz(6)

  payments               BookingPayment[]

  @@map("workshop_enquiries")
}

model BookingPayment {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiry_id   String          @db.Uuid
  amount_pence Int
  paid_on      DateTime        @db.Date
  note         String?
  created_at   DateTime?       @default(now()) @db.Timestamptz(6)
  enquiry      WorkshopEnquiry @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)

  @@map("booking_payments")
}

model WorkshopInterest {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName  String?
  email      String    @unique
  source     String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  @@map("workshop_interest")
}
